#!/bin/bash
# create and delete file

filepath=/run/user/1000/wallpaper_safe
text="If this file exists, the slideshow will be sfw"

if [ -e "$filepath" ]; then
    rm "$filepath"
    notify-send -a "$USER@$(cat /etc/hostname)" "Resume normal slideshow"
else
    echo "$text" > "$filepath"
    notify-send -a "$USER@$(cat /etc/hostname)" "Safe mode"
fi
