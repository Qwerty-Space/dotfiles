#!/bin/sh

set -e
pausepath=/run/user/1000/wallpaper_paused
safepath=/run/user/1000/wallpaper_safe
lockimg="/tmp/lockimg.png"

# Default values
force=false
file_path=""

# Parse command-line arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
  -f | --force)
    force=true
    shift
    ;;
  *)
    # Assume any other argument is the file path
    file_path="$1"
    shift
    ;;
  esac
done

shuffle() {
  if [ ! -e "$safepath" ]; then
    bg=$(find "/home/qwerty/Saved Pictures/Wallpapers/Desktop" -type f | shuf -n 1)
  elif [ -e "$safepath" ]; then
    bg=$(find "/home/qwerty/Saved Pictures/Wallpapers/Desktop" -type f -and -not -ipath '*/NSFW/*' | shuf -n 1)
  fi
  echo "Found wallpaper $bg" >&2
  echo "$bg"
}

set_wp() {
  wallpaper=$1
  if [ -z $1 ]; then
    wallpaper=$(shuffle)
  fi
  echo $wallpaper
 
  mime=$(file -b --mime-type -- "$wallpaper")

  case "$mime" in
    image/gif|video/*)
      mpvpaper -s -a full -f -o "no-audio loop" ALL "$wallpaper"
      ;;
    *)
      noctalia msg wallpaper-set "$wallpaper"
      sleep 2; pkill mpvpaper
      ;;
  esac

  echo "Set wallpaper to $(basename "$wallpaper")" >&2
}

if [ "$force" == true ]; then
  notify-send -a "$USER@$(cat /etc/hostname)" "Randomising wallpaper"
  set_wp
elif [ -n "$file_path" ]; then
  set_wp "$file_path"
elif [ ! -e "$pausepath" ]; then
  set_wp
fi
