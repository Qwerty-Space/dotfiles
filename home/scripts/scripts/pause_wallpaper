#!/bin/bash
# create and delete file

filepath=/run/user/1000/wallpaper_paused
text="If this file exists, the slideshow will be paused"

if [ -e "$filepath" ]; then
    rm "$filepath"
    notify-send -a "$USER@$(cat /etc/hostname)" "Resume slideshow"
else
    echo "$text" > "$filepath"
    notify-send -a "$USER@$(cat /etc/hostname)" "Pause slideshow"
fi
